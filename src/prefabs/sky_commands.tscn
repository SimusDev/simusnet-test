[sub_resource type="GDScript" id="GDScript_r4nrv"]
resource_name = "commands_script"
script/source = "extends SD_NodeConsoleCommands

@export var sky3d:Sky3D

func _ready() -> void:
	super()
	on_executed.connect(_on_command_executed)

func _on_command_executed(command:SD_ConsoleCommand) -> void:
	if not SimusNetConnection.is_server():
		return
	match command.get_code():
		\"time.set\":
			if command.get_arguments().size() < 1:
				return
			var cmd:String = command.get_value_as_string()
			if cmd.ends_with(\"m\"):
				var hours:float = (cmd.left(cmd.find(\"m\")).to_float() / 1440) * 24
				sky3d.current_time = hours
			elif cmd.ends_with(\"h\"):
				sky3d.current_time = cmd.left(cmd.find(\"h\")).to_float()
			sky3d.current_time
			return
"

[sub_resource type="Resource" id="Resource_yev43"]
script = ExtResource("1_t26ig")
code = "time.set"
value = "8.0h"
