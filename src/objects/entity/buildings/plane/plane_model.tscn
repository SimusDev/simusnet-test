[gd_scene format=3 uid="uid://dolrgxr4y86p3"]

[sub_resource type="Shader" id="Shader_mwvr1"]
code = "shader_type spatial;

uniform float speed = 1.0;
uniform float frequency = 2.0;

void fragment() {
    float time_offset = TIME * speed;
    
    float r = sin(UV.x * frequency + time_offset) * 0.5 + 0.5;
    float g = sin(UV.y * frequency + time_offset + 2.0) * 0.5 + 0.5;
    float b = sin((UV.x + UV.y) * frequency + time_offset + 4.0) * 0.5 + 0.5;
    
    ALBEDO = vec3(r, g, b);
    
}"

