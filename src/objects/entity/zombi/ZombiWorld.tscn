[sub_resource type="GDScript" id="GDScript_hcvt5"]
resource_name = "animation_script"
script/source = "extends Node3D

@export var state_machine:CT_StateMachineSimple

func _ready() -> void:
	state_machine.on_state_enter.connect(_on_state_enter)
	$\"../EntityAI/AI_AttackMelee\".on_impact.connect(sex)

func sex() -> void:
	var explosion = Explosion.new(LevelInstance.get_current(), global_position)
	explosion.set_scale(0.8)
	explosion.set_strength(0.7)
	get_tree().root.add_child(explosion)
	explosion.explode()

func _on_state_enter(state:String) -> void:
	#if $AnimationPlayer.is_playing():
		#return
	
	if $AnimationPlayer.has_animation(state):
		$AnimationPlayer.play(state)
"

